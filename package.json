{
  "name": "videos-worth-keeping",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx scripts/local/manage.ts start",
    "stop": "tsx scripts/local/manage.ts stop",
    "status": "tsx scripts/local/manage.ts status",
    "log": "tsx scripts/local/manage.ts log",
    "dev": "tsx scripts/local/manage.ts dev",
    "migrate": "pnpm --filter @likes/backend migrate",
    "fetch:bili": "pnpm --filter @likes/backend fetch:bili",
    "test": "pnpm test:shared && pnpm test:backend && pnpm test:web && pnpm test:runtime",
    "test:shared": "tsx --test \"packages/shared/src/**/*.test.ts\"",
    "test:backend": "tsx --test \"packages/backend/src/**/*.test.ts\"",
    "test:web": "tsx --test \"packages/web/src/**/*.test.ts\"",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke/run.ts",
    "reset": "pnpm --filter @likes/backend reset -- --yes",
    "smoke:clean": "pnpm reset && pnpm smoke",
    "check-secrets": "tsx scripts/check-secrets.ts",
    "backfill:bili-interactions": "pnpm --filter @likes/backend backfill:bili-interactions",
    "test:integration": "tsx scripts/smoke/database.ts sqlite && tsx scripts/smoke/database.ts mysql",
    "test:sqlite": "tsx scripts/smoke/database.ts sqlite",
    "test:mysql": "tsx scripts/smoke/database.ts mysql",
    "export:public": "tsx scripts/export-public.ts",
    "app:config": "tsx scripts/config.ts",
    "test:runtime": "tsx --test \"scripts/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "version": "0.1.0",
  "description": "收藏值得留下的视频，导入哔哩哔哩观看历史并按观看日期回顾。",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-550w/videos-worth-keeping.git"
  }
}
