# Reference only. Run pnpm app:config to create your private config and token.
# Actual configuration: <data-dir>/config/<profile>.env (gitignored).
DB_CLIENT=sqlite
# Relative paths resolve under APP_DATA_DIR; profile-specific defaults are automatic.
# SQLITE_PATH=db/default.sqlite
PORT=3050
WEB_PORT=5190
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN=
PROBE_ENABLED=0
CACHE_ENABLED=1
# To connect MySQL instead (5.7+):
# DB_CLIENT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=likes_collector
# DB_USER=likes_collector
# DB_PASSWORD='replace-me'
# BILI_CHROME_ACTIVE_PORT_FILE=/path/to/chrome-profile/DevToolsActivePort
# CORS_ORIGIN=https://your-site.example
